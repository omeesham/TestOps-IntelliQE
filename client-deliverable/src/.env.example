# ── Target environment ───────────────────────────────────────────────
# Selects which per-environment overrides apply: dev | qa | uat | prod.
# e.g. with ENV=qa, QA_BASE_URL / QA_USERNAME are used when present.
ENV=dev

# ── Application under test ────────────────────────────────────────────
# Base URL the browser navigates to. Override per env: QA_BASE_URL, UAT_BASE_URL…
BASE_URL=https://app.example.com
# Optional base URL for API setup/validation (the API layer).
API_BASE_URL=https://api.example.com

# ── Credentials — NEVER commit real values ────────────────────────────
# Read from the environment only. In CI, inject these from a secret manager.
# Per-env overrides also work: QA_USERNAME / QA_PASSWORD, etc.
USERNAME=
PASSWORD=

# ── Run settings (safe defaults) ──────────────────────────────────────
# Run browsers headless (true/false).
HEADLESS=true
# Parallel worker count. Leave unset (or 0) to auto-detect CPU cores — recommended,
# especially in CI. Set a number to cap it (e.g. on a shared/local machine).
# WORKERS=4
# Per-test timeout (ms).
TIMEOUT=30000
# Web-first assertion (expect) timeout (ms).
EXPECT_TIMEOUT=10000
# Retries: leave unset → 0 locally, 2 in CI. Set explicitly to override.
# RETRIES=2
# Log verbosity: error | warn | info | debug.
LOG_LEVEL=info
# Set true in CI to enable retries and forbid .only.
CI=false
