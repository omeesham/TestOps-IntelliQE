# ════════════════════════════════════════════════════════════════════════
#  JBS IntelliQE — environment variables (cloud-agnostic)
# ════════════════════════════════════════════════════════════════════════
#  Copy to `.env` for local dev; in production, inject these via Azure App
#  Service "Configuration", AWS Secrets Manager, GCP Secret Manager, or
#  Kubernetes Secrets — never commit `.env` to git.
#
#  Sections:
#    1. Runtime
#    2. Database
#    3. Crypto + JWT (required in production)
#    4. AI orchestration
#    5. Worker
#    6. Storage provider (artifacts)
#    7. Secrets provider (Key Vault / Secrets Manager / Secret Manager)
#    8. CORS + rate limits
#    9. SMTP (email notifications)
#   10. Logging
# ════════════════════════════════════════════════════════════════════════

# ── 1. Runtime ──────────────────────────────────────────────────────────
NODE_ENV=development                # development | production
PORT=3001                           # API port

# ── 2. Database (Azure SQL Database / SQL Server) ───────────────────────
# Azure SQL connection. AZURE_SQL_* take precedence; DB_* are accepted as
# fallbacks (and for local SQL Server in Docker).
AZURE_SQL_SERVER=                   # e.g. myserver.database.windows.net (no tcp:/port)
AZURE_SQL_DATABASE=JBSTestOpsAI     # the database name (Basic 5 DTU tier)
AZURE_SQL_USER=                     # e.g. intelliqe_app  (SQL auth login)
AZURE_SQL_PASSWORD=
AZURE_SQL_PORT=1433
DB_SSL=true                         # Azure SQL REQUIRES encryption; keep "true" in prod

# Local SQL Server (Docker) overrides — see docker-compose.yml:
#   DB_HOST=db  DB_USER=sa  DB_PASSWORD=Your_strong_Pass1  DB_NAME=JBSTestOpsAI
#   DB_SSL=true  DB_TRUST_SERVER_CERT=true  DB_BOOTSTRAP=true
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=
DB_NAME=JBSTestOpsAI
DB_TRUST_SERVER_CERT=false          # "true" for local self-signed certs (dev only)
DB_BOOTSTRAP=false                  # "true" lets the app CREATE the DB on local SQL Server

# ── 3. Crypto + JWT ─────────────────────────────────────────────────────
# Generate a 32-byte key:  openssl rand -base64 32
ENCRYPTION_KEY=                     # REQUIRED in production. Used for AES-256-GCM at-rest encryption.
# Generate at least 32 chars:  openssl rand -hex 32
JWT_SECRET=                         # REQUIRED in production. HS256 signing key.
JWT_EXPIRES_IN=24h                  # 1h | 24h | 7d, etc.
LEGACY_TOKEN_AUTH=true              # set to "false" after all clients have re-logged in to JWT.

# ── 4. AI orchestration (Anthropic / Claude) ────────────────────────────
# Platform-default Anthropic key — used only when a tenant has not set its own
# (tenants.anthropic_api_key). Per HIPAA architecture, tenants should bring
# their own keys; leave this empty to enforce tenant-owned keys.
ANTHROPIC_API_KEY=
# Directory containing the agent prompts (the JBS orchestration intelligence).
# Defaults to repo-root /.github/agents — override to ship as a separate artifact.
AGENTS_DIR=

# ── 5. Worker process ──────────────────────────────────────────────────
WORKER_SECRET=change-me-in-production   # required, shared between API and worker
WORKER_ID=local-worker-1                # unique per worker replica
BACKEND_URL=http://localhost:3001       # worker dials this URL

# ── 6. Storage provider (test artifacts) ────────────────────────────────
STORAGE_PROVIDER=local              # local | azure-blob | s3 | gcs

# local
STORAGE_LOCAL_DIR=./artifacts

# azure-blob
AZURE_STORAGE_CONNECTION_STRING=    # DefaultEndpointsProtocol=...;AccountKey=...
AZURE_STORAGE_CONTAINER=intelliqe-artifacts

# s3
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY come from the standard AWS chain
# (or IAM role when running on EC2 / ECS / EKS).

# gcs
GCP_PROJECT_ID=
GCP_STORAGE_BUCKET=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json (or use Workload Identity)

# ── 7. Secrets provider (where getSecret() reads from) ──────────────────
SECRETS_PROVIDER=env                # env | azure-kv | aws-sm | gcp-sm

# azure-kv (uses DefaultAzureCredential — Managed Identity in App Service)
AZURE_KEY_VAULT_URL=                # https://<vault-name>.vault.azure.net/

# aws-sm uses the standard AWS credential chain + AWS_REGION above.
# gcp-sm uses GCP_PROJECT_ID above + Application Default Credentials.

# ── 8. CORS + rate limits ───────────────────────────────────────────────
ALLOWED_ORIGINS=*                   # comma-separated origins in prod, e.g. https://app.intelliqe.com,https://staging.intelliqe.com
RATE_LIMIT_GENERAL=100              # req/min on /api/*
RATE_LIMIT_AUTH=5                   # req/min on /api/auth/login + signup

# ── 9. SMTP (email notifications) ───────────────────────────────────────
# Per-tenant SMTP can be configured in System Configuration UI; these are the
# fallback when a tenant has no notif-email integration configured.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_CC=

# ── 10. Logging + audit ─────────────────────────────────────────────────
LOG_LEVEL=info                      # debug | info | warn | error
AUDIT_INCLUDE_READS=false           # set "true" for HIPAA-strict mode (logs every GET on public routes)
