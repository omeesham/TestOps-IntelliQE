# ============================================================================
# JBSIntelliQE — backend environment
# Copy this file to `.env` and fill in the values. `npm run dev` auto-loads it.
# ============================================================================

# ─────────────────────────────────────────────────────────────
# AI engine (Anthropic) — REQUIRED for test generation
# ─────────────────────────────────────────────────────────────
# With this set, the backend talks to the Anthropic API directly: durable,
# headless, and portable. This is the recommended way to run the pipeline —
# unlike an interactive `claude auth login`, an API key does not expire and
# works for anyone who clones the repo (each developer sets their own key).
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-opus-4-8 (highest quality).
# For lower cost, use claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-opus-4-8

# (Fallback) If ANTHROPIC_API_KEY is NOT set, the backend shells out to a
# locally-signed-in `claude` CLI instead. That login expires periodically and
# must be refreshed with `claude auth login --claudeai` — which is exactly the
# recurring failure the API key above avoids. Prefer the API key.

# ─────────────────────────────────────────────────────────────
# Database (Azure SQL in prod / SQL Server in Docker for local dev)
# Local dev: docker-compose up → localhost:1433, db + schema "JBSTestOpsAI".
# ─────────────────────────────────────────────────────────────
AZURE_SQL_SERVER=localhost
AZURE_SQL_DATABASE=JBSTestOpsAI
AZURE_SQL_USER=sa
AZURE_SQL_PASSWORD=
AZURE_SQL_PORT=1433
DB_SCHEMA=JBSTestOpsAI
DB_SSL=false
DB_TRUST_SERVER_CERT=true
# Auto-create the database on boot (local dev convenience). Leave unset in prod.
DB_BOOTSTRAP=true

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Comma-separated CORS allow-list (defaults to the Vite dev origin if unset).
# ALLOWED_ORIGINS=http://localhost:5173
# RATE_LIMIT_GENERAL=
# RATE_LIMIT_AUTH=

# ─────────────────────────────────────────────────────────────
# Auth & crypto
# ─────────────────────────────────────────────────────────────
# Base64 of 32 random bytes — encrypts stored credentials at rest.
# A DEV fallback is used if unset (NOT secure — set this outside local dev).
ENCRYPTION_KEY=
# JWT_SECRET=
# JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────
# Worker process (npm run worker:start) — only if running pipeline workers
# ─────────────────────────────────────────────────────────────
# BACKEND_URL=http://localhost:3001
# WORKER_SECRET=
# WORKER_ID=
# AGENTS_DIR=

# ─────────────────────────────────────────────────────────────
# Test execution (Playwright)
# ─────────────────────────────────────────────────────────────
# Browser channel for real runs (e.g. msedge, chrome). Defaults to bundled Chromium.
# PLAYWRIGHT_CHANNEL=msedge
# PLAYWRIGHT_WORKERS=1

# ─────────────────────────────────────────────────────────────
# Optional integrations (leave unset if unused)
# ─────────────────────────────────────────────────────────────
# Email (test-run notifications)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# SMTP_FROM=
# SMTP_TO=
# Jira custom field for acceptance criteria
# JIRA_AC_FIELD_KEY=
# File storage provider: local | azure | s3 | gcs (defaults to local)
# STORAGE_PROVIDER=local
# STORAGE_LOCAL_DIR=
# Secrets provider: env | azure | aws | gcp (defaults to env)
# SECRETS_PROVIDER=env
# LOG_LEVEL=info
