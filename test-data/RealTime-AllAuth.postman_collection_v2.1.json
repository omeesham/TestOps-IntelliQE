      "description": "Full CRUD + echo, no auth.",
      "item": [
        {
          "name": "List posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{jsonph}}/posts",
              "host": [
                "{{jsonph}}"
              ],
              "path": [
                "posts"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
