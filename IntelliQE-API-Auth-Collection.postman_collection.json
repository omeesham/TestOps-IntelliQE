    },
    {
      "name": "6 - Digest Auth",
      "description": "Challenge-response auth; the password is hashed with a server nonce (never sent in the clear). Not natively modelled by the flow engine - imports as a plain request; runs in Postman/Newman.",
      "item": [
        {
          "name": "httpbin - digest auth",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://httpbin.org/digest-auth/auth/user/passwd"
            },
            "auth": {
              "type": "digest",
              "digest": [
                {
                  "key": "username",
                  "value": "user",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "passwd",
                  "type": "string"
                },
                {
                  "key": "algorithm",
                  "value": "MD5",
                  "type": "string"
                }
              ]
            },
            "description": "Ready to run. qop=auth, user / passwd."
          }
        },
        {
          "name": "Postman Echo - digest auth",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://postman-echo.com/digest-auth"
            },
            "auth": {
              "type": "digest",
              "digest": [
                {
                  "key": "username",
                  "value": "postman",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "password",
                  "type": "string"
                },
                {
                  "key": "algorithm",
                  "value": "MD5",
                  "type": "string"
                }
              ]
            },
            "description": "Ready to run. Credentials postman / password."
          }
        }
      ]
    },
    {
      "name": "7 - OAuth 2.0 (Client Credentials)",
      "description": "Machine-to-machine: the app trades client_id/secret for an access token, then calls the API with Bearer.",
      "item": [
        {
          "name": "Spotify - get token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "https://accounts.spotify.com/api/token"
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{spotify_client_id}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{spotify_client_secret}}",
                  "type": "string"
                }
              ]
            },
            "description": "Free signup. Returns access_token; use it as a Bearer token for api.spotify.com.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "Spotify - new releases (Bearer)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://api.spotify.com/v1/browse/new-releases"
            },
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "accessToken",
                  "value": "{{spotify_token}}",
                  "type": "string"
                },
                {
                  "key": "tokenType",
                  "value": "Bearer",
                  "type": "string"
                },
                {
                  "key": "addTokenTo",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "description": "Free signup. Paste the access_token from the 'get token' call into {{spotify_token}}."
          }
        },
        {
          "name": "PayPal Sandbox - get token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "https://api-m.sandbox.paypal.com/v1/oauth2/token"
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{paypal_client_id}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{paypal_client_secret}}",
                  "type": "string"
                }
              ]
            },
            "description": "Sandbox. Create a sandbox app at developer.paypal.com.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "8 - OAuth 2.0 (Authorization Code)",
      "description": "3-legged: the user authorizes in a browser, the app swaps the returned code for a token. These requests hit the protected resource with that token.",
      "item": [
        {
          "name": "Google - userinfo (OAuth token)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://www.googleapis.com/oauth2/v3/userinfo"
            },
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "accessToken",
                  "value": "{{google_oauth_token}}",
                  "type": "string"
                },
                {
                  "key": "tokenType",
                  "value": "Bearer",
                  "type": "string"
                },
                {
                  "key": "addTokenTo",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "description": "Free signup. Token obtained via accounts.google.com/o/oauth2/v2/auth -> oauth2.googleapis.com/token."
          }
        },
        {
          "name": "GitHub - user (OAuth app token)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://api.github.com/user"
            },
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "accessToken",
                  "value": "{{github_oauth_token}}",
                  "type": "string"
                },
                {
                  "key": "tokenType",
                  "value": "Bearer",
                  "type": "string"
                },
                {
                  "key": "addTokenTo",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "description": "Free signup. Token from an OAuth App flow: github.com/login/oauth/authorize -> access_token."
          }
        }
      ]
    },
    {
      "name": "9 - OAuth 1.0",
      "description": "Each request is signed with a consumer key/secret and an HMAC-SHA1 signature.",
      "item": [
        {
          "name": "Postman Echo - OAuth 1.0",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://postman-echo.com/oauth1"
            },
            "auth": {
              "type": "oauth1",
              "oauth1": [
                {
                  "key": "consumerKey",
                  "value": "RKCGzna7bv9YD57c",
                  "type": "string"
                },
                {
                  "key": "consumerSecret",
                  "value": "D+EdQ-gs$-%@2Nu7",
                  "type": "string"
                },
                {
                  "key": "signatureMethod",
                  "value": "HMAC-SHA1",
                  "type": "string"
                },
                {
                  "key": "addParamsToHeader",
                  "value": true,
                  "type": "boolean"
                },
                {
                  "key": "version",
                  "value": "1.0",
                  "type": "string"
                }
              ]
            },
            "description": "Ready to run. Shared Postman test consumer key/secret."
          }
        }
      ]
    },
    {
      "name": "10 - JWT (login -> token)",
      "description": "POST credentials to a login endpoint, receive a signed JWT, then send it as a Bearer token.",
      "item": [
        {
          "name": "DummyJSON - login",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "https://dummyjson.com/auth/login"
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Ready to run. Returns accessToken (a JWT).",
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"emilys\", \"password\": \"emilyspass\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "DummyJSON - current user (Bearer JWT)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://dummyjson.com/auth/me"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{dummyjson_jwt}}",
                  "type": "string"
                }
              ]
            },
            "description": "Ready to run. Paste the accessToken from 'login' into {{dummyjson_jwt}}."
          }
        },
        {
          "name": "ReqRes - login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{reqres_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "https://reqres.in/api/login"
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Free signup. Returns a token; ReqRes requires the x-api-key header.",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"eve.holt@reqres.in\", \"password\": \"cityslicka\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "11 - Hawk Auth",
      "description": "MAC-based auth using an id/key pair plus an optional payload hash. Imports as a plain request in the flow engine; runs in Postman/Newman.",
      "item": [
        {
          "name": "Postman Echo - Hawk",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://postman-echo.com/auth/hawk"
            },
            "auth": {
              "type": "hawk",
              "hawk": [
                {
                  "key": "authId",
                  "value": "dh37fgj492je",
                  "type": "string"
                },
                {
                  "key": "authKey",
                  "value": "werxhqb98rpaxn39848xrunpaw3489ruxnpa98w4rxn",
                  "type": "string"
                },
                {
                  "key": "algorithm",
                  "value": "sha256",
                  "type": "string"
                }
              ]
            },
            "description": "Ready to run. Shared Postman Hawk test id/key (SHA256)."
          }
        }
      ]
    },
    {
      "name": "12 - AWS Signature v4",
      "description": "Request signed with an AWS access/secret key, scoped to a region and service. Imports as a plain request in the flow engine; runs in Postman/Newman.",
      "item": [
        {
          "name": "AWS DynamoDB - ListTables (SigV4)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Amz-Target",
                "value": "DynamoDB_20120810.ListTables",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/x-amz-json-1.0",
                "type": "text"
              }
            ],
            "url": {
              "raw": "https://dynamodb.us-east-1.amazonaws.com/"
            },
            "auth": {
              "type": "awsv4",
              "awsv4": [
                {
                  "key": "accessKey",
                  "value": "{{aws_access_key}}",
                  "type": "string"
                },
                {
                  "key": "secretKey",
                  "value": "{{aws_secret_key}}",
                  "type": "string"
                },
                {
                  "key": "region",
                  "value": "us-east-1",
                  "type": "string"
                },
                {
                  "key": "service",
                  "value": "dynamodb",
                  "type": "string"
                }
              ]
            },
            "description": "Free AWS account. Signed with your AWS access/secret key.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ],
