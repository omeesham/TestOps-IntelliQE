              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearer_token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Ready to run. httpbin accepts any non-empty bearer token."
          }
        },
