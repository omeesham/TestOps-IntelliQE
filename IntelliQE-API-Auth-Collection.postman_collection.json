    {
      "name": "5 - Basic Auth",
      "description": "Base64(username:password) in the Authorization: Basic header.",
      "item": [
        {
          "name": "httpbin - basic auth",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://httpbin.org/basic-auth/user/passwd"
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "user",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "passwd",
                  "type": "string"
                }
              ]
            },
            "description": "Ready to run. Credentials user / passwd."
          }
        },
