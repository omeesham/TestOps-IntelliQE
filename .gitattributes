# Binary files: never convert line endings (keeps PDFs and media intact)
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.docx binary
*.xlsx binary
*.pptx binary

# Files that run inside the Linux container: always LF, even on a Windows checkout
*.sh text eol=lf
docker/** text eol=lf
Dockerfile text eol=lf
